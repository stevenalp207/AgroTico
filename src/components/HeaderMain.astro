---

import Logo from '../assets/theme-images/agroticologo.svg'

const { settings } = Astro.props

---

<header class="fixed top-4 left-0 right-0 z-50 pointer-events-auto">

  <div class="bs-container">
    <div class="bg-bs-surface-2/60 backdrop-blur-sm rounded-xl py-4 px-6 flex justify-between items-center shadow-md">

      <!-- Logo -->
      <a class="flex xl:min-w-32 items-center gap-3 group" href="/" aria-label={ settings.title + ' - Home' }>

        <span class="hidden md:inline text-sm font-semibold text-bs-foreground-light">{ settings.title }</span>

      </a>

      <!-- Nav -->
      <nav class="hidden md:flex mx-auto items-center gap-4">
        { settings.nav.map( item => (
          <a href={item.link} class="text-sm text-bs-foreground-dark hover:text-bs-foreground-light px-3 py-2 rounded-md transition-colors">{item.title}</a>
        )) }
      </nav>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <a href="https://agrotico-smart-dashboard.vercel.app/" target="_blank" rel="noopener noreferrer" class="bs-btn bs-btn-primary">{ settings.demo.title }</a>
        <button class="bs-btn" aria-label="Open menu" onclick="document.getElementById('contactDialog')?.showModal()">Contact</button>
      </div>

    </div>
  </div>

</header>
