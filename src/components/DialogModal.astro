---
import X from "../assets/theme-images/icon-x.svg"
import SocialLinks from "./SocialLinks.astro"
---

<dialog id="contactDialog" class="fixed inset-0 bg-bs-surface-0/95 m-auto z-50 p-6 md:p-10 rounded-2xl w-full max-w-[95%] md:max-w-lg shadow-2xl text-white">
  <form method="dialog" class="flex flex-col gap-6">
    <!-- Header -->
    <h2 class="bs-h2 flex justify-between items-center font-display text-bs-primary-400">
      <span>🌱 Conecta con AgroTico Smart</span>
      <button
        onclick="this.closest('dialog').close('close')"
        aria-label="Cerrar"
        class="bs-btn rounded-full !p-0 flex items-center justify-center h-10 w-10"
      >
        <X class="scale-75 opacity-75" width="32" height="32" />
      </button>
    </h2>

    <!-- Body -->
    <div class="flex flex-col gap-6 text-center">
      <p class="text-bs-neutral-200 text-lg">
        ¡Nos encanta colaborar y compartir ideas!  
        Puedes seguirnos o escribirnos directamente:
      </p>

      <!-- Redes sociales -->
      <SocialLinks variant="dialog" />

      <p class="text-sm text-bs-neutral-400 mt-6">
        También puedes escribirnos por WhatsApp o correo para colaboraciones o demostraciones.  
        <br />🌾 ¡Gracias por apoyar la innovación tica!
      </p>
    </div>

    <div class="flex justify-center mt-4">
      <button
        class="bs-btn px-6 py-3 rounded-full"
        onclick="this.closest('dialog').close('close')"
      >
        Cerrar
      </button>
    </div>
  </form>
</dialog>

<style>
html:has(dialog[open]) {
  overflow: hidden;
  scrollbar-gutter: stable;
}
dialog[open]::backdrop {
  backdrop-filter: blur(50px);
}
@keyframes scale-up {
  to { translate: 0 0; scale: 1; }
}
@media (prefers-reduced-motion: no-preference) {
  dialog { translate: 0 2rem; scale: 0.8; }
  dialog[open] {
    animation: scale-up forwards 0.8s;
    animation-timing-function: var(--ease-bs-spring);
  }
}
</style>
