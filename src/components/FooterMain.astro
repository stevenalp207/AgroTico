---
import Logo from "../assets/theme-images/agroticologo.svg"
import SocialLinks from "./SocialLinks.astro"
const { settings } = Astro.props
---

<footer id="contact" class="bs-container my-24 text-bs-foreground-dark">

  <!-- Wrapper -->
  <div class="bg-gradient-to-b from-transparent/20 to-black/10 p-6 md:p-16 rounded-xl grid md:grid-cols-2 gap-8 items-center shadow-inner border border-transparent/6">
    <!-- Left col -->
    <div class="w-max flex flex-col gap-8 md:gap-0 justify-between text-bs-foreground-light">
      <!-- Logo -->
      <a class="flex group" href="#top" aria-label="Back to top">
        <Logo
          class="group-hover:scale-[1.05] group-hover:-rotate-1 transition-transform ease-bs-spring duration-1000"
          height="200"
          width="200"
        />
      </a>

      <!-- Info -->
      <div class="flex flex-col gap-3 text-sm text-bs-foreground-dark mt-4">
        <p class="text-base text-bs-foreground-light font-normal">
          Innovación costarricense 🇨🇷<br/>
          Transformando el campo con tecnología
        </p>
        <p>
          📧 <a href="mailto:agroticosmart@gmail.com" class="hover:underline">agroticosmart@gmail.com</a>
        </p>
        <p>
          📱 <a href="https://wa.me/50671903969" target="_blank" rel="noopener noreferrer" class="hover:underline">+506 7190-3969</a>
        </p>
      </div>

      <!-- Social links -->
      <SocialLinks variant="footer" />
    </div>

    <!-- Right col -->
    <div class="flex gap-10 md:gap-2 lg:gap-20 md:justify-end [&_a]:block md:[&_a]:px-5 [&_a]:py-2">
      <!-- Nav -->
      <nav class="flex flex-col">
        <h3 class="text-bs-foreground-light font-bold mb-3">Navegación</h3>
        {settings.nav.map((item) => (
          <a href={item.link}>{item.title}</a>
        ))}
        <a href="#contact">Contacto</a>
      </nav>

      <!-- Quick Links -->
      <nav class="flex flex-col">
        <h3 class="text-bs-foreground-light font-bold mb-3">Recursos</h3>
        <a href="https://agrotico-smart-dashboard.vercel.app/" target="_blank" rel="noopener noreferrer">Dashboard</a>
        <a href="https://github.com/agrotico-smart" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.instagram.com/agroticosmart/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>
    </div>
  </div>

  </div>

  <!-- Colophon -->
  <aside class="bs-container mt-8">
    <nav class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-8 text-xs text-bs-neutral-400">
      <a href="https://agroticosmart.vercel.app/">© {new Date().getFullYear()} AgroTico Smart</a>
      <span class="hidden sm:inline">•</span>
      <span>Colegio Técnico Profesional Don Bosco</span>
      <span class="hidden sm:inline">•</span>
      <span class="text-[#4caf50]">Finalistas Solve For Tomorrow 2025</span>
    </nav>
  </aside>
</footer>
