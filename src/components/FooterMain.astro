---
import Logo from "../assets/theme-images/agroticologo.svg"
import SocialLinks from "./SocialLinks.astro"
const { settings } = Astro.props
---

<footer
  class="@container bs-container my-24 font-semibold text-bs-foreground-dark [&_a]:hover:text-bs-foreground-light [&_a]:transition-colors [&_a]:duration-150"
  id="contact"
>
  <!-- Wrapper -->
  <div
    class="bg-bs-surface-2 p-6 md:p-16 rounded-xl grid md:grid-cols-2 gap-8 items-center"
  >
    <!-- Left col -->
    <div class="w-max flex flex-col gap-8 md:gap-0 justify-between text-bs-foreground-light">
      <!-- Logo -->
      <a class="flex group" href="#top" aria-label="Back to top">
        <Logo
          class="group-hover:scale-[1.05] group-hover:-rotate-1 transition-transform ease-bs-spring duration-1000"
          height="200"
          width="200"
        />
      </a>

      <!-- Info -->
      <div class="flex flex-col gap-3 text-sm text-bs-foreground-dark mt-4">
        <p class="text-base text-bs-foreground-light font-normal">
          <span data-i18n="footer.innovation">Innovación costarricense 🇨🇷</span><br/>
          <span data-i18n="footer.transforming">Transformando el campo con tecnología</span>
        </p>
        <p>
          📧 <a href="mailto:agroticosmart@gmail.com" class="hover:underline">agroticosmart@gmail.com</a>
        </p>
        <p>
          📱 <a href="https://wa.me/50671903969" target="_blank" rel="noopener noreferrer" class="hover:underline">+506 7190-3969</a>
        </p>
      </div>

      <!-- Social links -->
      <SocialLinks variant="footer" />
    </div>

    <!-- Right col -->
    <div class="flex gap-10 md:gap-2 lg:gap-20 md:justify-end [&_a]:block md:[&_a]:px-5 [&_a]:py-2">
      <!-- Nav -->
      <nav class="flex flex-col">
        <h3 class="text-bs-foreground-light font-bold mb-3" data-i18n="footer.navigation">Navegación</h3>
        <a href="/#servicios" data-i18n="nav.services">Servicios</a>
        <a href="/#casos-de-exito" data-i18n="nav.caseStudies">Casos de éxito</a>
        <a href="/#precios" data-i18n="nav.pricing">Precios</a>
        <a href="/#faq" data-i18n="nav.faq">Preguntas frecuentes</a>
        <a href="#contact" data-i18n="footer.contact">Contacto</a>
      </nav>

      <!-- Quick Links -->
      <nav class="flex flex-col">
        <h3 class="text-bs-foreground-light font-bold mb-3" data-i18n="footer.resources">Recursos</h3>
        <a href="https://agrotico-smart-dashboard.vercel.app/" target="_blank" rel="noopener noreferrer" data-i18n="footer.dashboard">Dashboard</a>
        <a href="https://github.com/agrotico-smart" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.instagram.com/agroticosmart/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>
    </div>
  </div>

  <!-- Colophon -->
  <aside class="bs-container">
    <nav class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-16 md:pt-24 text-xs text-bs-neutral-400">
      <a href="https://agroticosmart.vercel.app/">© {new Date().getFullYear()} <span data-i18n="footer.copyright">AgroTico Smart</span></a>
      <span class="hidden sm:inline">•</span>
      <span data-i18n="footer.school">Colegio Técnico Profesional Don Bosco</span>
      <span class="hidden sm:inline">•</span>
      <span class="text-[#4caf50]" data-i18n="footer.achievement">Finalistas Solve For Tomorrow 2025 🏆</span>
    </nav>
  </aside>
</footer>
