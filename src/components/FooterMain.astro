---
import Logo from "../assets/theme-images/agroticologo.svg"
const { settings } = Astro.props
---

<footer
  class="@container bs-container my-24 font-semibold text-bs-foreground-dark [&_a]:hover:text-bs-foreground-light [&_a]:transition-colors [&_a]:duration-150"
  id="contact"
>
  <!-- Wrapper -->
  <div
    class="bg-bs-surface-2 p-6 md:p-16 rounded-xl grid md:grid-cols-2 gap-8 items-center"
  >
    <!-- Left col -->
    <div class="w-max flex flex-col gap-8 md:gap-0 justify-between text-bs-foreground-light">
      <!-- Logo -->
      <a class="flex group" href="#top" aria-label="Back to top">
        <Logo
          class="group-hover:scale-[1.05] group-hover:-rotate-1 transition-transform ease-bs-spring duration-1000"
          height="200"
          width="200"
        />
      </a>

      <!-- Social links -->
      <div class="flex gap-6 mt-6 text-bs-neutral-300">
        <!-- Instagram -->
        <a href="https://www.instagram.com/agroticosmart/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="w-6 h-6 hover:text-pink-400 transition-colors">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="3.5"></circle>
            <circle cx="17" cy="7" r="0.5" fill="currentColor"></circle>
          </svg>
        </a>

        <!-- GitHub -->
        <a href="https://github.com/agrotico-smart" target="_blank" rel="noopener" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6 hover:text-gray-400 transition-colors">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.207 11.387.6.11.793-.26.793-.577v-2.02c-3.338.726-4.04-1.61-4.04-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.744.083-.73.083-.73 1.205.084 1.84 1.238 1.84 1.238 1.07 1.834 2.807 1.304 3.492.997.11-.776.42-1.305.763-1.605-2.665-.304-5.467-1.333-5.467-5.93 0-1.31.468-2.382 1.236-3.22-.124-.304-.536-1.528.116-3.183 0 0 1.008-.322 3.3 1.23a11.52 11.52 0 0 1 3.006-.404c1.02.005 2.045.138 3.006.404 2.29-1.552 3.295-1.23 3.295-1.23.653 1.655.24 2.88.117 3.183.77.838 1.234 1.91 1.234 3.22 0 4.61-2.807 5.624-5.48 5.922.432.37.823 1.102.823 2.222v3.293c0 .32.19.694.8.576C20.565 21.796 24 17.3 24 12c0-6.63-5.37-12-12-12z"
            />
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href="https://wa.me/50671903969" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6 hover:text-green-400 transition-colors">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.1-.472-.148-.67.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.654-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.52-.075-.149-.669-1.612-.916-2.206-.242-.579-.487-.5-.67-.51l-.571-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.718 2.006-1.412.248-.694.248-1.289.173-1.412-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.514-5.29c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05.003C5.495.003.16 5.336.157 11.89c0 2.1.547 4.148 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.889-5.334 11.892-11.888a11.821 11.821 0 0 0-3.473-8.418Z"
            />
          </svg>
        </a>

        <!-- Correo -->
        <a href="mailto:agroticosmart@gmail.com" aria-label="Correo">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="w-6 h-6 hover:text-blue-400 transition-colors">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right col -->
    <div class="flex gap-10 md:gap-2 lg:gap-20 md:justify-end [&_a]:block md:[&_a]:px-5 [&_a]:py-2">
      <!-- Nav -->
      <nav class="flex flex-col">
        {settings.nav.map((item) => (
          <a href={item.link}>{item.title}</a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Colophon -->
  <aside class="bs-container">
    <nav class="flex gap-4 justify-center pt-16 md:pt-24 text-xs text-bs-neutral-400">
      <a href="https://agroticosmart.vercel.app/">© {new Date().getFullYear()} por AgroTico Smart</a>
    </nav>
  </aside>
</footer>
