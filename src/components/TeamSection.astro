---
import SectionHeader from "./SectionHeader.astro";
const { title, team } = Astro.props
---

<section
  id="equipo"
  class="relative w-full mx-0 px-0 py-20 bg-bs-surface-950 text-white"
>
  <!-- Contenido centrado al ancho del FAQ -->
  <div class="bs-container flex flex-col gap-12">
    <SectionHeader 
      title={title}
      subtitle={"🌱🤖 Con mucho orgullo presentamos al equipo detrás de AgroTico Smart 🚜💡<br/>Nuestro proyecto nació con un objetivo claro: llevar innovación real al campo costarricense, ayudando a los agricultores a enfrentar el cambio climático con tecnología accesible y práctica."}
    />

    <div class="flex flex-wrap justify-center gap-8">
      {team.map((member) => (
        <article
          class="group w-full sm:w-[45%] lg:w-[30%] bg-bs-surface-0/50 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden hover:scale-[1.02] hover:shadow-2xl hover:shadow-[#4caf50]/10 transition-all duration-500"
        >
          <div class="overflow-hidden">
            <img
              src={member.image}
              alt={`Foto de ${member.name} - ${member.role}`}
              class="h-64 w-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6 flex flex-col gap-2 text-center">
            <h3 class="font-display text-2xl font-medium text-bs-foreground-light">{member.name}</h3>
            <p class="uppercase text-sm tracking-widest text-[#4caf50] font-semibold">
              {member.role}
            </p>
            <p class="text-sm text-bs-neutral-300 leading-relaxed mt-2" set:html={member.bio} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
