---
const { videoId } = Astro.props;
const API_KEY = import.meta.env.YOUTUBE_API_KEY;

let likeCount = null;

if (API_KEY && videoId) {
  try {
    const res = await fetch(
      `https://www.googleapis.com/youtube/v3/videos?part=statistics&id=${videoId}&key=${API_KEY}`
    );
    const data = await res.json();
    likeCount = data.items?.[0]?.statistics?.likeCount || "N/A";
  } catch (e) {
    console.error("Error al obtener likes:", e);
  }
}
---

<div class="flex items-center gap-1 text-sm text-bs-foreground-dark">
  <span>👍</span>
  <span>{likeCount}</span>
</div>
