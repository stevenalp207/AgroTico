---

import DetailsAccordion from "./DetailsAccordion.astro"

const { title, faq } = Astro.props

---

<section class="bs-container bs-mt-lg grid" id="faq">

  <!-- Title -->
  { title && <h2 class="bs-h2 text-center md:text-left mb-4" set:html={ title } />}
  
  <!-- Subtitle -->
  <p class="text-center md:text-left text-bs-foreground-dark text-lg mb-8 max-w-3xl">
    ¿Tienes dudas? Aquí encontrarás respuestas a las preguntas más frecuentes sobre AgroTico Smart
  </p>

  <!-- FAQ -->
  <div class="grid gap-2 bs-mt-sm">

    <!-- Item -->
    { faq.map( item =>

      <DetailsAccordion question={item.question} answer={item.answer} />

    )}

  </div>
  
  <!-- Additional Help -->
  <div class="mt-12 p-6 md:p-8 bg-bs-surface-2 rounded-xl border border-bs-surface-3 text-center">
    <h3 class="bs-h3 mb-4">¿No encontraste tu respuesta?</h3>
    <p class="text-bs-foreground-dark mb-6">
      Estamos aquí para ayudarte. Contáctanos y te responderemos a la brevedad.
    </p>
    <button
      type="button"
      class="bs-btn bs-btn-primary"
      onclick="document.getElementById('contactDialog').showModal()"
    >
      Contactar al equipo
    </button>
  </div>

</section>
