---

import Image from "astro/components/Image.astro"
import hero_screens from "../assets/theme-images/hero-screens.png"

const { settings, title, content } = Astro.props

---

<section class="bs-container py-6 flex flex-col lg:flex-row items-center gap-8">

  <!-- Content -->
  <div class="flex flex-col gap-6 lg:max-w-lg w-full py-16">

    <!-- Title -->
    <h1 class="bs-h1" set:html={ title } />

    <!-- Content -->
    <div class="bs-body-text xl:text-xl flex flex-col gap-4 [&_p]:last:text-bs-foreground-dark" set:html={ content } />

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mt-4">
      <button 
        type="button"
        class="bs-btn bs-btn-primary"
        onclick="window.location.href='https://agrotico-smart-dashboard.vercel.app/'"
      >
        🚀 Ver Dashboard
      </button>
      <button
        type="button"
        class="bs-btn"
        onclick="document.getElementById('contactDialog').showModal()"
      >
        📞 Contáctanos
      </button>
    </div>

  </div>

  <!-- Image -->
  <figure class="flex place-content-center -mt-20 lg:mt-0">

    <Image src={ hero_screens } format="avif" quality="high" alt="Screens showing phone, tablet and desktop views of our website" loading="eager" />

  </figure>

</section>
