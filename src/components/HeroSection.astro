---

import Image from "astro/components/Image.astro"
import logo from "../assets/theme-images/agroticologo.svg"

const { settings } = Astro.props

---

<section class="hero-root">
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-inner text-center">

    <figure class="hero-logo" aria-hidden="false">
      <Image src={logo} alt={settings?.siteName ?? 'Logo'} loading="eager" sizes="(min-width:1280px) 70vw, 90vw" />
    </figure>

  </div>
</section>
