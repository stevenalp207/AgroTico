---

const { content, image, cite, role } = Astro.props

---

<!-- Quote -->
<blockquote class="bs-container bs-mt-lg font-display text-2xl md:text-3xl lg:text-4xl flex flex-col gap-6 p-8 md:p-12 bg-bs-surface-2 rounded-2xl border border-bs-surface-3" id="quote">

  <!-- Icon -->
  <svg class="w-12 h-12 text-[#4caf50] opacity-50" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>

  <!-- Text -->
  <div set:html={ content } class="text-bs-foreground-dark bs-st-quote [&_strong]:font-normal font-display leading-relaxed" />

  <!-- Cite -->
  <cite class="not-italic flex gap-4 items-center mt-4">

    <img
      src={ image }
      class="h-16 w-16 rounded-full border-2 border-[#4caf50] object-cover"
      alt={`Logo de ${cite}`}
      width="128"
      height="128"
      loading="lazy"
    >

    <div class="text-bs-foreground-light bs-h3 flex flex-col gap-1">
      <span class="text-xl md:text-2xl">{ cite }</span>
      <span class="text-base md:text-lg text-bs-foreground-dark font-normal">{ role }</span>
    </div>

  </cite>

</blockquote>
<div class="mt-20"></div>

<style is:global>

/* Lighten text when scrolling into view */

@keyframes white-text {
  to { color: var(--color-bs-foreground-light); }
}

@supports (animation-timeline: view()) {
  .bs-st-quote strong {
    animation: white-text linear;
    animation-timeline: view(20% block);
    animation-fill-mode: forwards;
  }
}

@supports (not (animation-timeline: view())) {
  .bs-st-quote strong {
    color: var(--color-bs-foreground-light)
  }
}

</style>

