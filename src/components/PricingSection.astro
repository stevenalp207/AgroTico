---
import Check from '../assets/theme-images/icon-check.svg'
import Cube from '../assets/theme-images/icon-cube.svg'
import CubeOutline from '../assets/theme-images/icon-cube-outline.svg'

const { title, pricing } = Astro.props
---

<section class="w-full bs-mt-lg bg-bs-surface-950 text-white py-12" id="precios">
  <div class="bs-container">
    <!-- Header -->
    { title && <h2 class="bs-h2 text-center mb-4">{ title }</h2>}
    
    <!-- Subtitle -->
    <p class="text-center text-bs-foreground-dark text-lg mb-12 max-w-2xl mx-auto">
      Inversión accesible para transformar tu producción agrícola con tecnología de punta
    </p>

    <!-- Pricing -->
    <div class="mt-8 flex flex-wrap justify-center gap-8">

      { pricing.map((item, index) => (
        <article
          class:list={[
            '@container p-6 xl:p-16 flex flex-col gap-6 h-full w-full max-w-md rounded-xl overflow-hidden lg:scale-90 @xl:justify-end transform transition-all duration-300 hover:scale-95 lg:hover:scale-100',
            index === 1
              ? 'bg-white/90 text-black/90 lg:scale-none shadow-2xl shadow-[#4caf50]/20'
              : 'bg-bs-surface-0/90 border border-bs-surface-3'
          ]}
        >

          <!-- Content -->
          <div class="relative">

            <!-- Title -->
            <h2 class="bs-h3 flex gap-3 items-center">

              <!-- Icon -->
              { index === 1 && <Cube height="32" width="32" /> }
              { index !== 1 && <CubeOutline height="32" width="32" /> }

              <!-- Title -->
              <span>{ item.title }</span>

              <!-- Tag -->
              <div
                class="text-xs uppercase tracking-widest font-semibold hidden sm:block ms-auto rounded-full px-4 py-2 pb-[0.4rem] border border-bs-foreground-dark/30"
                set:html={ item.tag } />
            </h2>

            <!-- Intro -->
            <div class="text-xl flex-grow mt-4" set:html={ item.content } />

            <!-- Services list -->
            <ul role="list" class="flex flex-col gap-4 my-8">
              { item.services.map(({ item }) => (
                <li class="flex gap-2 md:gap-3 items-start">
                  <Check class="flex-shrink-0 mt-1" height="24" width="24" />
                  <span class="text-lg md:text-xl">{ item }</span>
                </li>
              ))}
            </ul>

            <footer class="flex flex-col sm:flex-row justify-between items-center gap-4">
              <!-- Price -->
              <span class="text-4xl lg:text-5xl font-bold">
                ${ item.price }
                <span class="text-xl text-bs-foreground-dark font-normal ms-2">USD</span>
              </span>

              <!-- CTA button -->
              <button
                type="button"
                class="bs-btn bs-btn-primary inline-block self-start @4xl:mt-12 text-xl w-full sm:w-auto"
                onclick="document.getElementById('contactDialog').showModal()"
              >
                { item.cta }
              </button>
            </footer>

          </div>
        </article>
      ))}

    </div>
  </div>
</section>
