---
const { videoId = "sx-50RiG60k", title = "Video Destacado" } = Astro.props;
const API_KEY = import.meta.env.YOUTUBE_API_KEY;

let likeCount = null;

if (API_KEY && videoId) {
  try {
    const res = await fetch(
      `https://www.googleapis.com/youtube/v3/videos?part=statistics&id=${videoId}&key=${API_KEY}`
    );
    const data = await res.json();
    likeCount = data.items?.[0]?.statistics?.likeCount || "N/A";
  } catch (e) {
    console.error("Error al obtener likes:", e);
  }
}
---

<section class="bs-container bs-mt-lg text-center">
  <!-- Title -->
  <h2 class="bs-h2">{title}</h2>

  <!-- Video -->
  <div class="mt-4 aspect-video w-full max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-md border border-bs-surface-3 bg-bs-surface-2">
    <iframe
      src={`https://www.youtube.com/embed/${videoId}`}
      class="w-full h-full"
      title="YouTube video"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  <!-- Likes Counter -->
  <div
    class="group mt-4 inline-flex flex-col items-center justify-center px-8 py-6 border rounded-2xl bg-bs-surface-2 border-bs-surface-3 transition-all duration-300 hover:scale-[1.03] hover:shadow-lg"
  >
    <span class="text-5xl md:text-6xl font-bold text-bs-foreground">
      👍 {likeCount ?? "Cargando..."}
    </span>
    <span class="text-base md:text-lg text-bs-foreground-dark mt-2">
      Likes en YouTube
    </span>
  </div>

  <!-- Extra spacing below the counter -->
  <div class="mt-12"></div>
</section>
