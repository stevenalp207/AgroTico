---
const { videoId = "sx-50RiG60k", title = "Video Destacado" } = Astro.props;
const API_KEY = import.meta.env.YOUTUBE_API_KEY;
---
<section class="bs-container bs-mt-lg text-center" 
         data-video-id={videoId} data-api-key={API_KEY}>

  <!-- Title -->
  <h2 class="bs-h2">{title}</h2>

  <!-- Video (click-to-load placeholder) -->
  <div class="mt-4 aspect-video w-full max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-md border border-bs-surface-3 bg-bs-surface-2">
    <button
      class="w-full h-full relative group video-placeholder"
      aria-label="Cargar video"
      data-video-id={videoId}
      type="button"
    >
      <img
        src={`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`}
        alt={title}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="rounded-full bg-black/60 group-hover:bg-black/70 p-4">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden>
            <path d="M8 5v14l11-7L8 5z" fill="white" />
          </svg>
        </div>
      </div>
    </button>
  </div>

  <!-- Stats Counters -->
  <div class="mt-4 mx-auto flex flex-col md:flex-row justify-center gap-6 max-w-4xl" id="youtube-stats">

    <!-- Likes -->
    <div class="group flex-1 inline-flex flex-col items-center justify-center px-6 py-5 border rounded-2xl bg-bs-surface-2 border-bs-surface-3 transition-all duration-300 hover:scale-[1.03] hover:shadow-lg"
         id="likes-counter">
      <span class="text-5xl md:text-5xl font-bold text-bs-foreground">👍 Cargando...</span>
      <span class="text-base md:text-lg text-bs-foreground-dark mt-2">Likes</span>
    </div>

    <!-- Views -->
    <div class="group flex-1 inline-flex flex-col items-center justify-center px-6 py-5 border rounded-2xl bg-bs-surface-2 border-bs-surface-3 transition-all duration-300 hover:scale-[1.03] hover:shadow-lg"
         id="views-counter">
      <span class="text-5xl md:text-5xl font-bold text-bs-foreground">👀 Cargando...</span>
      <span class="text-base md:text-lg text-bs-foreground-dark mt-2">Vistas</span>
    </div>

    <!-- Comments -->
    <div class="group flex-1 inline-flex flex-col items-center justify-center px-6 py-5 border rounded-2xl bg-bs-surface-2 border-bs-surface-3 transition-all duration-300 hover:scale-[1.03] hover:shadow-lg"
         id="comments-counter">
      <span class="text-5xl md:text-5xl font-bold text-bs-foreground">💬 Cargando...</span>
      <span class="text-base md:text-lg text-bs-foreground-dark mt-2">Comentarios</span>
    </div>

  </div>

  <!-- Extra spacing below the counters -->
  <div class="mt-20"></div>

  <!-- Script para actualizar stats en cliente (carga inmediata) -->
  <script type="module" client:load>
    const section = document.querySelector('section[data-video-id]');
    const videoId = section?.dataset.videoId;
    const API_KEY = section?.dataset.apiKey;

    async function updateStats() {
      if (!videoId || !API_KEY) {
        console.warn('YouTube API: Missing videoId or API key');
        document.querySelector("#likes-counter span").textContent = "👍 N/A";
        document.querySelector("#views-counter span").textContent = "👀 N/A";
        document.querySelector("#comments-counter span").textContent = "💬 N/A";
        return;
      }

      try {
        const res = await fetch(`https://www.googleapis.com/youtube/v3/videos?part=statistics&id=${videoId}&key=${API_KEY}`);
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        const data = await res.json();
        const stats = data.items?.[0]?.statistics;
        if (!stats) throw new Error('No statistics data available');

        const formatNumber = (num) => (num ? parseInt(num).toLocaleString('es') : "N/A");

        document.querySelector("#likes-counter span").textContent = `👍 ${formatNumber(stats.likeCount)}`;
        document.querySelector("#views-counter span").textContent = `👀 ${formatNumber(stats.viewCount)}`;
        document.querySelector("#comments-counter span").textContent = `💬 ${formatNumber(stats.commentCount)}`;
      } catch (e) {
        console.error("Error al obtener stats de YouTube:", e);
        document.querySelector("#likes-counter span").textContent = "👍 Error";
        document.querySelector("#views-counter span").textContent = "👀 Error";
        document.querySelector("#comments-counter span").textContent = "💬 Error";
      }
    }

    updateStats();
    setInterval(updateStats, 30000);
  </script>

  <!-- Script para reemplazar placeholder por iframe al hacer click (deferred) -->
  <script type="module" client:idle>
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.video-placeholder');
      if (!btn) return;
      const vid = btn.dataset.videoId || btn.getAttribute('data-video-id');
      if (!vid) return;

      const wrapper = btn.parentElement;
      const iframe = document.createElement('iframe');
      iframe.setAttribute('src', `https://www.youtube.com/embed/${vid}?autoplay=1&rel=0`);
      iframe.setAttribute('class', 'w-full h-full');
      iframe.setAttribute('title', btn.getAttribute('aria-label') || 'YouTube video');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');

      // Replace the button with the iframe
      wrapper.replaceChild(iframe, btn);
    });
  </script>
</section>
