---

import Layout from "../layouts/Layout.astro"

import CaseStudiesSection from "../components/CaseStudiesSection.astro"
import ClientsSection from "../components/ClientsSection.astro"
import FaqSection from "../components/FaqSection.astro"
import ServicesCarousel from "../components/ServicesCarousel.astro"
import HeroSection from "../components/HeroSection.astro"
import PricingSection from "../components/PricingSection.astro"
import QuoteSection from "../components/QuoteSection.astro"
import YouTubeLikes from "../components/YouTubeLikes.astro"
import TeamSection from "../components/TeamSection.astro"
import TestimonialsSection from "../components/TestimonialsSection.astro"
import ContactDialog from "../components/DialogModal.astro"
import AchievementsSection from "../components/AchievementsSection.astro"

import caseStudies from "../data/casos-de-exito.json"
import clients from "../data/clients.json"
import faq from "../data/faq.json"
import services from "../data/servicios.json"
import home from "../data/home.json"
import pricing from "../data/precios.json"
import global_settings from "../data/global_settings.json"
import testimonials from "../data/testimonials.json"
import team from "../data/team.json"
import achievements from "../data/achievements.json";

---

<Layout title={ global_settings.title }>

  <HeroSection
    content={ home.hero_content }
    settings={ global_settings }
    title={ home.hero_title }
  />

  <YouTubeLikes
    videoId="sx-50RiG60k"
    title="Nuestro video promocional - Apoyanos tu like"
  />

  <QuoteSection
    cite={ home.quote_cite }
    content={ home.quote_content }
    image={ home.quote_image }
    role={ home.quote_role }
  /> <!-- Descripcion del proyecto -->

  <ServicesCarousel
    services={ services }
    title={ home.services_title }
  /> <!-- Servicios del producto que ofrecemos -->

  <TeamSection
    title="Conoce al Equipo"
    team={ team }
  />

  <ClientsSection
    clients={ clients }
    title={ home.clients_title }
  /> <!-- Patrocinadores y respaldo -->

  <CaseStudiesSection
    caseStudies={ caseStudies }
    title={ home.case_studies_title }
  /> <!-- Nuestro impacto -->

  <PricingSection
    pricing={ pricing }
    title={ home.pricing_title }
  /> <!-- Precio -->
  <ContactDialog />


  <FaqSection
    faq={ faq }
    title={ home.faq_title }
  />

  <AchievementsSection achievements={achievements} />

</Layout>
